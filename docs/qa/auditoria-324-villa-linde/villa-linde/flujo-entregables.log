  await page.waitForFunction(()=>BPDP.app.state.A===0&&!BPDP.app.state.playing,null,{timeout:40000});
  await page.screenshot({path:out+'P9-separado.png'});
  await d.getByRole('button',{name:'Ensamblar',exact:true}).click({timeout:8000});
  await page.waitForFunction(()=>BPDP.app.state.A===1&&!BPDP.app.state.playing,null,{timeout:40000});
  return {same:await page.evaluate(s=>JSON.stringify(BPDP.studio.transformSignature())===s,signature)};
 });
 await exit();
 report.planosIntactos=(await saved())===before;
 await check('studio',async()=>{
