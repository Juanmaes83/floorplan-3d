   const selector=d.locator('[data-view="'+view+'"]');
   if(!(await selector.isVisible()))await d.locator('[data-intent="clean"]').click({timeout:8000});
   await selector.click({timeout:8000});
   views.push(await page.evaluate(()=>BPDP.app.state.view));
   await page.screenshot({path:out+'P8-'+view+'.png'});
  }
  return views;
 });
 await exit();
 await check('despiece',async()=>{
  const d=await open('P9','despiece','Abrir Despiece');
  const signature=await page.evaluate(()=>JSON.stringify(BPDP.studio.transformSignature()));
