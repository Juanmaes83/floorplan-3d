 await page.waitForFunction(()=>FloorPlanApp.viewMode==='3d');
 await page.getByRole('button',{name:'Entregar',exact:true}).click();
 const saved=()=>page.evaluate(()=>JSON.stringify(FloorPlanBuildingUI.presentationSources().levels.map(l=>l.project)));
 const before=await saved();
 async function open(card,mod,label){
  const key=page.locator('#bpdpOpen-'+mod);
  if(await key.isVisible())await key.click();
  else{
   await page.locator('[data-entrega-code="'+card+'"] .perla-card-selector').click({position:{x:12,y:12}});
   await page.locator('.perla-panel-open').getByRole('button',{name:label,exact:true}).click({timeout:12000});
  }
  await page.waitForFunction(()=>Boolean(window.BPDP?.studio),null,{timeout:25000});
  return page.locator('dialog.bpdp-host[open]');
 }
 async function exit(){if(await page.locator('dialog.bpdp-host[open]').isVisible()){await page.keyboard.press('Escape');await page.waitForFunction(()=>!window.BpdpEntregar.abierta);}}
 await check('blueprint',async()=>{
  const d=await open('P8','blueprint','Abrir Blueprint');
  const views=[];
