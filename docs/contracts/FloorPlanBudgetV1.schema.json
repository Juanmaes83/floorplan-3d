{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubik-sota.local/contracts/FloorPlanBudgetV1.schema.json",
  "title": "FloorPlanBudgetV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "subject", "title", "currency", "taxRatePercent", "chapters", "items"],
  "properties": {
    "schema": {"const": "rubik-sota.floorplan-budget"},
    "schemaVersion": {"enum": ["1.0.0", "1.1.0"]},
    "id": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/subject"},
    "title": {"type": "string", "minLength": 1},
    "currency": {"const": "EUR"},
    "taxRatePercent": {
      "oneOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0, "maximum": 100}
      ]
    },
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "items": {"type": "array"}
  },
  "oneOf": [
    {"properties": {"schemaVersion": {"const": "1.0.0"}, "items": {"items": {"$ref": "#/$defs/item"}}}},
    {"properties": {"schemaVersion": {"const": "1.1.0"}, "items": {"items": {"$ref": "#/$defs/item11"}}}}
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["project", "building"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "order": {"type": "integer"}
      }
    },
    "quantityEngineSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "engine", "ref"],
      "properties": {
        "type": {"const": "quantity-engine"},
        "engine": {"const": "FloorPlanQuantities"},
        "ref": {"type": "object"}
      }
    },
    "manualQuantitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {"const": "manual"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "status", "complete", "source"],
      "properties": {
        "value": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "unit": {"enum": ["m2", "m", "unit"]},
        "status": {"enum": ["measured", "estimated", "unavailable"]},
        "complete": {"type": "boolean"},
        "source": {"oneOf": [{"$ref": "#/$defs/quantityEngineSource"}, {"$ref": "#/$defs/manualQuantitySource"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {"properties": {"value": {"const": null}, "complete": {"const": false}}},
          "else": {"properties": {"value": {"type": "number", "minimum": 0}}}
        }
      ]
    },
    "manualPriceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "asOf"],
      "properties": {
        "type": {"const": "manual"},
        "label": {"type": "string", "minLength": 1},
        "asOf": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}]}
      }
    },
    "providerPriceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "providerId", "itemId"],
      "properties": {
        "type": {"const": "provider-reference"},
        "providerId": {"type": "string", "minLength": 1},
        "itemId": {"type": "string", "minLength": 1}
      }
    },
    "nullableText": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "nullableUrl": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https?://"}]},
    "priceReferenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "asOf", "retrievedAt", "edition", "region", "sourceUrl", "attribution", "licenseStatus", "licenseName", "licenseUrl"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "asOf": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
        "retrievedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "edition": {"$ref": "#/$defs/nullableText"},
        "region": {"$ref": "#/$defs/nullableText"},
        "sourceUrl": {"$ref": "#/$defs/nullableUrl"},
        "attribution": {"$ref": "#/$defs/nullableText"},
        "licenseStatus": {"enum": [null, "not-applicable", "unknown", "verified", "restricted"]},
        "licenseName": {"$ref": "#/$defs/nullableText"},
        "licenseUrl": {"$ref": "#/$defs/nullableUrl"}
      }
    },
    "priceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "itemId", "code", "description", "unit", "unitPrice", "currency", "priceKind", "source"],
      "properties": {
        "providerId": {"type": "string", "minLength": 1},
        "itemId": {"type": "string", "minLength": 1},
        "code": {"$ref": "#/$defs/nullableText"},
        "description": {"type": "string", "minLength": 1},
        "unit": {"enum": ["m2", "m", "unit"]},
        "unitPrice": {"type": "number", "minimum": 0},
        "currency": {"const": "EUR"},
        "priceKind": {"const": "reference"},
        "source": {"$ref": "#/$defs/priceReferenceSource"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedAt"],
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed"]},
        "reviewedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]},
          "then": {"properties": {"reviewedAt": {"type": "string", "format": "date-time"}}},
          "else": {"properties": {"reviewedAt": {"const": null}}}
        }
      ]
    },
    "item11": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapterId", "description", "quantity", "wastePercent", "unitPrice", "priceSource", "priceReference", "review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "chapterId": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "description": {"type": "string", "minLength": 1},
        "quantity": {"$ref": "#/$defs/quantity"},
        "wastePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "unitPrice": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "priceSource": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/manualPriceSource"}, {"$ref": "#/$defs/providerPriceSource"}]},
        "priceReference": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/priceReference"}]},
        "taxRatePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {
          "if": {"properties": {"unitPrice": {"type": "null"}}, "required": ["unitPrice"]},
          "then": {"properties": {"priceSource": {"const": null}, "review": {"properties": {"status": {"const": "unreviewed"}, "reviewedAt": {"const": null}}}}},
          "else": {"properties": {"priceSource": {"not": {"const": null}}}}
        },
        {
          "if": {"properties": {"priceSource": {"$ref": "#/$defs/providerPriceSource"}}, "required": ["priceSource"]},
          "then": {"properties": {"priceReference": {"$ref": "#/$defs/priceReference"}}}
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapterId", "description", "quantity", "wastePercent", "unitPrice", "priceSource", "review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "chapterId": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "description": {"type": "string", "minLength": 1},
        "quantity": {"$ref": "#/$defs/quantity"},
        "wastePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "unitPrice": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0}]},
        "priceSource": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/manualPriceSource"}]},
        "taxRatePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "review": {"$ref": "#/$defs/review"}
      },
      "allOf": [
        {
          "if": {"properties": {"unitPrice": {"type": "null"}}, "required": ["unitPrice"]},
          "then": {
            "properties": {
              "priceSource": {"const": null},
              "review": {"allOf": [{"$ref": "#/$defs/review"}, {"properties": {"status": {"const": "unreviewed"}, "reviewedAt": {"const": null}}}]}
            }
          },
          "else": {"properties": {"priceSource": {"$ref": "#/$defs/manualPriceSource"}}}
        }
      ]
    }
  }
}
