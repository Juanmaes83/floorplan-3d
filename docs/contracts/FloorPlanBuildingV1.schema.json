{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Juanmaes83/floorplan-3d/docs/contracts/FloorPlanBuildingV1.schema.json",
  "title": "FloorPlanBuildingV1",
  "description": "Edificio de varias plantas (opción D de la PR #50): incrusta un FloorPlanProjectV1 1.x completo por planta. El validador de referencia es js/building-core.js; aplica además las reglas semánticas de FloorPlanBuildingV1.md y valida cada proyecto incrustado en modo estricto.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "name", "createdAt", "updatedAt", "units", "levels", "stairs"],
  "properties": {
    "schema": { "const": "rubik-sota.floorplan-building" },
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"], "description": "1.1 adds optional shared site; other versions are rejected." },
    "site": { "$ref": "FloorPlanProjectV1.schema.json#/$defs/site" },
    "id": { "type": "string", "pattern": "^bld_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "units": { "const": "mm" },
    "levels": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/level" } },
    "stairs": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/stair" } }
  },
  "allOf": [{"if":{"properties":{"schemaVersion":{"const":"1.0.0"}}},"then":{"not":{"required":["site"]}}}],
  "$defs": {
    "levelId": { "type": "string", "pattern": "^lvl_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
    "pointMm": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }, "y": { "type": "integer", "minimum": -1000000, "maximum": 1000000 } }
    },
    "level": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "order", "elevationMm", "slabThicknessMm", "offsetMm", "project"],
      "properties": {
        "id": { "$ref": "#/$defs/levelId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "order": { "type": "integer", "minimum": 0, "maximum": 1, "description": "Igual a su posición en levels." },
        "elevationMm": { "type": "integer", "minimum": 0, "maximum": 100000, "description": "Suelo terminado en el marco del edificio. 0 en la planta 0." },
        "slabThicknessMm": { "type": "integer", "minimum": 0, "maximum": 1000, "description": "Espesor visual del forjado bajo la planta; sin significado estructural. 0 en la planta 0." },
        "offsetMm": { "$ref": "#/$defs/pointMm", "description": "Traslación del marco del proyecto al marco del edificio. {0,0} en la planta 0." },
        "project": { "$ref": "FloorPlanProjectV1.schema.json", "description": "Proyecto 1.x (1.0.0–1.8.0) completo, validado en modo estricto." }
      }
    },
    "stair": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "fromLevelId", "toLevelId", "startMm", "rotationDeg", "widthMm", "runLengthMm", "risers"],
      "properties": {
        "id": { "type": "string", "pattern": "^str_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
        "kind": { "const": "straight" },
        "fromLevelId": { "$ref": "#/$defs/levelId" },
        "toLevelId": { "$ref": "#/$defs/levelId" },
        "startMm": { "$ref": "#/$defs/pointMm", "description": "Centro del borde del primer peldaño, en el marco del edificio." },
        "rotationDeg": { "type": "integer", "minimum": 0, "maximum": 359, "description": "Sentido de subida, horario en planta." },
        "widthMm": { "type": "integer", "minimum": 300, "maximum": 5000 },
        "runLengthMm": { "type": "integer", "minimum": 500, "maximum": 20000 },
        "risers": { "type": "integer", "minimum": 2, "maximum": 40 }
      }
    }
  }
}
