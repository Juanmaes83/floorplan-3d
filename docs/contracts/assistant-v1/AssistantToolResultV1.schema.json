            "invalid_arguments",
            "not_authorized",
            "not_found",
            "not_available",
            "revision_mismatch",
            "conflict",
            "rate_limited",
            "budget_exceeded",
            "timeout",
            "cancelled",
            "provider_disabled",
            "consent_required",
            "unsupported_intent",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
