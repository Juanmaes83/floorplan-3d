      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "unavailable",
            "mixed",
            "not_applicable"
          ]
        },
        "engine": {
          "type": "string",
          "maxLength": 200
        },
        "asOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "budgetId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "error": {
      "type": "object",
