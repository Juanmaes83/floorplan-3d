      "const": "1.0.0"
    },
    "callId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "provenance": {
