{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubik-sota.example/contracts/assistant-v1/AssistantRunAuditV1.schema.json",
  "title": "AssistantRunAuditV1",
  "description": "Contrato AssistantRunAuditV1 v1.0.0 del Asistente IA RUBIK. Generado por scripts/assistant/write-schemas.cjs desde js/assistant-contracts.js: no editar a mano.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "at",
    "mode",
    "tools",
    "providerCalls",
    "cost"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "mode": {
      "enum": [
        "deterministic",
        "mock",
        "provider"
      ]
    },
    "area": {
      "enum": [
        "design",
        "analyze",
        "budget",
        "deliver",
        "studio"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "revision": {
      "type": "string",
      "maxLength": 150
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "tools": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "providerCalls": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedUsd",
        "billedUsd",
        "basis"
      ],
      "properties": {
        "estimatedUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "billedUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "maxLength": 200
        }
      },
      "description": "Desconocido = null, nunca 0 por omisión. Sin llamadas al proveedor, exactamente 0."
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_arguments",
            "not_authorized",
            "not_found",
            "not_available",
            "revision_mismatch",
            "conflict",
            "rate_limited",
            "budget_exceeded",
            "timeout",
            "cancelled",
            "provider_disabled",
            "consent_required",
            "unsupported_intent",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
